rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'grinto25@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 256
        && data.role is string && data.role.size() <= 32 && data.role in ['ADMIN', 'MANAGER', 'CASHIER', 'WAITER', 'KITCHEN', 'INVENTORY']
        && data.createdAt is timestamp;
    }

    function isValidPosSnapshot(data) {
      return data.keys().hasAll(['ownerId', 'snapshotType', 'version', 'summary', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'snapshotType', 'version', 'summary', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.snapshotType is string && data.snapshotType.size() <= 32 && data.snapshotType in ['STATE_SYNC', 'BACKUP', 'AUDIT_CHECKPOINT']
        && data.version is number && data.version >= 1
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPosOrderCloud(data) {
      return data.keys().hasAll(['ownerId', 'orderNumber', 'orderType', 'status', 'totalAmount', 'idempotencyKey', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'orderNumber', 'orderType', 'status', 'totalAmount', 'idempotencyKey', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 64 && data.orderNumber.matches('^[a-zA-Z0-9_\\-]+$')
        && data.orderType is string && data.orderType.size() <= 32 && data.orderType in ['DINE_IN', 'TAKEAWAY', 'DELIVERY']
        && data.status is string && data.status.size() <= 32 && data.status in ['NEW', 'CONFIRMED', 'PREPARING', 'READY', 'OUT_FOR_DELIVERY', 'DELIVERED', 'COMPLETED', 'CANCELLED', 'HELD']
        && data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 100000000
        && data.idempotencyKey is string && data.idempotencyKey.size() >= 1 && data.idempotencyKey.size() <= 128 && data.idempotencyKey.matches('^[a-zA-Z0-9_\\-]+$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isVerified() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isBootstrappedAdmin() && existing().uid == request.auth.uid;
      allow create: if isVerified() && isValidId(adminId) && isValidAdminUser(incoming()) && incoming().uid == adminId && incoming().createdAt == request.time && isBootstrappedAdmin();
      allow update: if isVerified() && isValidId(adminId) && isValidAdminUser(incoming()) && (
        isBootstrappedAdmin()
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'email'])
      );
      allow delete: if isVerified() && isValidId(adminId) && isBootstrappedAdmin();
    }

    match /pos_snapshots/{snapshotId} {
      allow get: if isVerified() && isValidId(snapshotId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified() && isValidId(snapshotId) && isValidPosSnapshot(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(snapshotId) && isValidPosSnapshot(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['version', 'summary', 'snapshotType', 'updatedAt'])
        )
      );
      allow delete: if isVerified() && isValidId(snapshotId) && isAdmin();
    }

    match /pos_orders/{orderId} {
      allow get: if isVerified() && isValidId(orderId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified() && isValidId(orderId) && isValidPosOrderCloud(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(orderId) && isValidPosOrderCloud(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid
          && !(existing().status in ['COMPLETED', 'CANCELLED'])
          && incoming().ownerId == existing().ownerId
          && incoming().orderNumber == existing().orderNumber
          && incoming().idempotencyKey == existing().idempotencyKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'totalAmount', 'updatedAt'])
        )
      );
      allow delete: if isVerified() && isValidId(orderId) && isAdmin();
    }
  }
}
